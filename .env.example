# ── Supabase ─────────────────────────────────────────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON=eyJ...    # anon/public key

# Usado nas Vercel Functions (server-side)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ... # service_role key (nunca expor no frontend)

# ── Anthropic / Claude ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...         # ou sk_test_... em desenvolvimento
STRIPE_WEBHOOK_SECRET=whsec_...       # gerado ao registrar o webhook no Stripe Dashboard
STRIPE_PRICE_PRO_BRL=price_...        # ID do price Pro em BRL (R$97/mês)
STRIPE_PRICE_BUSINESS_BRL=price_...   # ID do price Business em BRL (R$197/mês)
STRIPE_PRICE_PRO_USD=price_...        # ID do price Pro em USD ($19/mês) - opcional
STRIPE_PRICE_BUSINESS_USD=price_...   # ID do price Business em USD ($39/mês) - opcional

